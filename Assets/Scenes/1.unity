  - element:
    - elementType: 1
      tutorial: []
      talk:
      - talker: "\uC6D0\uC22D\uC774"
        talk: "\uC2AC\uB77C\uC784?| \uC5B4\uB5BB\uAC8C \uC5EC\uAE30 \uC788\uB294
          \uAC70\uC57C?"
        useImage: 1
        imageNum: 1
        canSkip: 1
        autoSkip: 0
        useFunctions: 0
        animEnd: 0
        animation: []
        camera: []
      - talker: "\uC2AC\uB77C\uC784"
        talk: "\uC5B4\uB514 \uC788\uB098 \uD588\uB354\uB2C8 \uBC14\uB85C \uC55E\uC5D0
          \uC788\uC5C8\uB124.| \uC624\uB79C\uB9CC\uC774\uB124,| \uC798 \uC9C0\uB0C8\uB0D0?"
        useImage: 1
        imageNum: 0
        canSkip: 1
        autoSkip: 0
        useFunctions: 0
        animEnd: 0
        animation: []
        camera: []
      - talker: "\uC6D0\uC22D\uC774"
        talk: "\uBB50,| \uADF8\uB2E5...| \uC5EC\uAE30\uC120 \uB531\uD788 \uD560 \uAC83\uB3C4
          \uC5C6\uC73C\uB2C8\uAE50 \uB9D0\uC57C."
        useImage: 1
        imageNum: 1
        canSkip: 1
        autoSkip: 0
        useFunctions: 0
        animEnd: 0
        animation: []
        camera: []
      - talker: "\uC2AC\uB77C\uC784"
        talk: "\uADF8\uB807\uACA0\uC9C0.| \uB108 \uB0B4 \uB2A5\uB825 \uAE30\uC5B5\uD558\uC9C0?|
          \uBAB8\uC18D\uC5D0 \uB2E4\uB978 \uB3D9\uBB3C \uB123\uACE0 \uB2E4\uB2C8\uBA74\uC11C
          \uADF8 \uB3D9\uBB3C\uB85C \uBCC0\uC2E0\uD558\uB294 \uAC70.| \uADF8\uAC70
          \uC368\uC11C \uB108\uB791 \uB098\uB791 \uAC19\uC774 \uB098\uAC00\uC790."
        useImage: 1
        imageNum: 0
        canSkip: 1
        autoSkip: 0
        useFunctions: 0
        animEnd: 0
        animation: []
        camera: []
      - talker: "\uC6D0\uC22D\uC774"
        talk: "\uADF8\uAC70...| \uACB0\uAD6D \uC548\uC804\uD55C\uC9C0 \uC544\uB2CC\uC9C0\uB294
          \uC544\uC9C1\uB3C4 \uBAA8\uB974\uB294 \uAC70 \uC544\uB0D0?"
        useImage: 1
        imageNum: 1
        canSkip: 1
