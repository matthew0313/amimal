  cutscene:
  - element:
    - elementType: 1
      tutorial: []
      talk:
      - talker: "\uC2AC\uB77C\uC784"
        talk: "\uC73C\uC74C...| \uC5B4\uB514\uB85C \uB098\uC628 \uAC74\uC9C0 \uC798
          \uBAA8\uB974\uACA0\uB124..."
        useImage: 1
