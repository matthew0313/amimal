        autoSkip: 0
        useFunctions: 0
        animEnd: 0
        animation: []
        camera: []
      - talker: "\uC2AC\uB77C\uC784"
        talk: "\uC7A0\uAE50,| \uC5EC\uAE34 \uC5B8\uC81C \uC640 \uBCF8 \uC801\uC774
          \uC788\uB294 \uAC83 \uAC19\uC740\uB370...|"
        useImage: 1
        imageNum: 0
        canSkip: 1
        autoSkip: 0
        useFunctions: 0
        animEnd: 0
        animation: []
        camera: []
      - talker: "\uC2AC\uB77C\uC784"
        talk: "\uC544,| \uB9DE\uB2E4.| \uC5EC\uAE30 \uC6D0\uC22D\uC774\uAC00 \uADF8\uB54C
          \uB04C\uB824\uC628 \uACF3\uC774\uC5C8\uC9C0.| \uADFC\uCC98\uC5D0 \uC788\uC73C\uBA74
