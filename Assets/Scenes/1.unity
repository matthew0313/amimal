        camera: []
      - talker: "\uC2AC\uB77C\uC784"
        talk: "\uC5D0\uC774,| \uBB50,| \uC124\uB9C8 \uC8FD\uACA0\uC5B4?| \uC77C\uB2E8
          \uD55C \uBC88 \uD574 \uBD10\uC57C\uC9C0 \uBB50."
