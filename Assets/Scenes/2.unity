  cutscene:
  - element:
    - elementType: 1
      tutorial: []
      talk:
      - talker: "\uC2AC\uB77C\uC784"
        talk: "\uC5B4\uB77C?| \uBC8C\uC368 \uBC24\uC774\uB124?| \uC6B0\uB9AC\uAC00
          \uD30C\uC774\uD504 \uC548\uC5D0\uC11C \uADF8\uB807\uAC8C \uC624\uB798 \uC788\uC5C8\uB098?"
        useImage: 1
        imageNum: 0
        canSkip: 1
        autoSkip: 0
        useFunctions: 0
        animEnd: 0
        animation: []
        camera: []
      - talker: "\uC6D0\uC22D\uC774"
        talk: "\uC544\uB9C8\uB3C4 \uC544\uB2D0 \uAC70\uC57C.| \uC544\uAE4C\uBD80\uD130
          \uC0DD\uAC01\uD55C \uAC74\uB370,| \uC544\uB9C8 \uC774 \uC815\uAE00\uB3C4
          \uC5F0\uAD6C\uC18C\uC5D0\uC11C \uB9CC\uB4E0 \uAC70\uC778 \uAC83 \uAC19\uC544.|
          \uD544\uC694\uC5D0 \uB530\uB77C \uC5B4\uB514\uB294 \uBC24 \uC5B4\uB514\uB294
          \uB0AE\uC73C\uB85C \uD560 \uC218 \uC788\uB294 \uAC78\uAEC4."
        useImage: 1
        imageNum: 1
        canSkip: 1
        autoSkip: 0
        useFunctions: 0
        animEnd: 0
        animation: []
        camera: []
      - talker: "\uBD80\uC5C9\uC774"
        talk: "\uB108\uB124,| \uB0B4 \uC55E\uC5D0 \uAC11\uC790\uAE30 \uB098\uD0C0\uB0AC\uC73C\uBA74
