        imageScale: 0.6
      - tutorialName: "\uD65C\uACF5 \uB3C4\uC911\uC758 \uACF5\uC911 \uC810\uD504"
        tutorialContent: "\uBD80\uC5C9\uC774\uB294 \uCD5C\uB300 5\uBC88 \uD65C\uACF5
