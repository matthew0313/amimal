        imageNum: 0
        canSkip: 1
        autoSkip: 0
        useFunctions: 0
        animEnd: 0
        animation: []
        camera: []
      - talker: "\uC2AC\uB77C\uC784"
        talk: "\uC624,| \uBD80\uC5C9\uC774\uC796\uC544!| \uC624\uB798\uAC04\uB9CC\uC774\uB124.|
