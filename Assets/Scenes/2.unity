      - talker: "\uBD80\uC5C9\uC774"
        talk: "\uC5EC\uAE30\uC5D0 \uAC19\uD78C \uC774\uD6C4\uB85C \uB108\uBB34 \uB530\uBD84\uD574\uC11C
