  cutscene:
  - element:
    - elementType: 1
      tutorial: []
      talk:
      - talker: "\uC2AC\uB77C\uC784"
        talk: "\uC774\uAC70 \uBB54\uAC00 \uB610 \uC804\uD600 \uB2E4\uB978 \uACF3\uC73C\uB85C
          \uB098\uC640\uBC84\uB9B0 \uAC83 \uAC19\uC740\uB370..."
        useImage: 1
        imageNum: 0
        canSkip: 1
        autoSkip: 0
        useFunctions: 0
        animEnd: 0
        animation: []
        camera: []
      - talker: "\uC6D0\uC22D\uC774"
        talk: "\uADF8\uB7EC\uAC8C.| \uC5EC\uAE30 \uCD9C\uAD6C\uB85C \uC774\uC5B4\uC9C0\uAE34
          \uD558\uB294 \uAC70 \uB9DE\uC544?"
        useImage: 1
        imageNum: 1
        canSkip: 1
        autoSkip: 0
        useFunctions: 0
        animEnd: 0
        animation: []
        camera: []
      - talker: "\uC2AC\uB77C\uC784"
        talk: "\uBB50,| \uADF8\uAC74 \uADF8\uB807\uAE30\uB97C \uBE4C \uC218\uBC16\uC5D0
          \uC5C6\uC9C0...|"
        useImage: 1
        imageNum: 0
        canSkip: 1
        autoSkip: 0
        useFunctions: 0
        animEnd: 0
        animation: []
        camera: []
      - talker: "\uC544\uB974\uB9C8\uB51C\uB85C"
        talk: "\uBB50\uC57C \uB108\uD76C\uB294?| \uC5B4\uB5BB\uAC8C \uC800 \uC218\uB3C4\uAD00\uC5D0\uC11C..."
        useImage: 0
        imageNum: 0
        canSkip: 1
        autoSkip: 0
        useFunctions: 0
        animEnd: 0
        animation: []
        camera: []
      - talker: "\uC2AC\uB77C\uC784"
        talk: "\uC624,| \uC5EC\uAE30\uC5D0\uC11C \uC0C8\uB85C\uC6B4 \uB3D9\uBB3C\uC774
          \uC788\uB124.| \uC57C,| \uB108\uB3C4 \uC5EC\uAE30\uC11C \uD0C8\uCD9C\uD558\uACE0
          \uC2F6\uC9C0?| \uC6B0\uB9AC\uB791 \uAC19\uC774 \uAC00\uC9C0 \uC54A\uACA0\uC5B4?"
        useImage: 1
        imageNum: 0
        canSkip: 1
        autoSkip: 0
        useFunctions: 0
        animEnd: 0
        animation: []
        camera: []
