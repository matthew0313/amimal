  - stageName: "\uC2A4\uD14C\uC774\uC9C0 0 - \uC5F0\uAD6C\uC18C \uACA9\uB9AC\uC2E4"
    stageDescription: "\uC218\uC0C1\uD55C \uD55C \uC5F0\uAD6C\uC18C\uC758 \uACA9\uB9AC\uC2E4.
      \uACA9\uB9AC\uB418\uC5B4 \uC788\uB358 \uC2AC\uB77C\uC784\uC740 \uB09C\uD3ED\uD55C
      \uACBD\uBE44\uC6D0\uC5D0 \uC758\uD574 \uC544\uB798\uCABD \uACF5\uAC04\uC73C\uB85C
      \uB5A8\uC5B4\uC9C0\uC9C0\uB9CC, \uADF8\uACF3\uC5D0\uC11C \uC758\uC678\uC758
      \uD0C8\uCD9C\uB85C\uB97C \uBC1C\uACAC\uD558\uAC8C \uB418\uB294\uB370..?"
  - stageName: "\uC2A4\uD14C\uC774\uC9C0 1 - \uC5F0\uAD6C\uC18C \uC815\uAE00 1"
    stageDescription: "\uACA9\uB9AC\uC2E4\uC5D0\uC11C \uD0C8\uCD9C\uD55C \uC2AC\uB77C\uC784\uC740
      \uC6D0\uC22D\uC774\uAC00 \uC7A1\uD600\uAC04 \uC815\uAE00\uB85C \uB098\uC624\uAC8C
      \uB418\uACE0, \uC6D0\uC22D\uC774\uB97C \uB9CC\uB098 \uC5F0\uAD6C\uC18C \uD0C8\uCD9C\uC744
      \uD568\uAED8\uD558\uAC8C \uB418\uB294\uB370..?"
  - stageName: "\uC2A4\uD14C\uC774\uC9C0 2 - \uC5F0\uAD6C\uC18C \uC815\uAE00 2"
    stageDescription: "\uC6D0\uC22D\uC774\uC640 \uD568\uAED8 \uC815\uAE00\uC744 \uB098\uC628...
      \uC904 \uC54C\uC558\uB358 \uC2AC\uB77C\uC784\uACFC \uC6D0\uC22D\uC774\uB294,
      \uC774\uBC88\uC5D4 \uBC24\uC778 \uC815\uAE00\uB85C \uB098\uC624\uAC8C \uB41C\uB2E4.
      \uADF8\uACF3\uC5D0\uC11C \uBD80\uC5C9\uC774\uB97C \uB9CC\uB098\uACE0, \uB2E4\uC74C
      \uC9C0\uC5ED\uC73C\uB85C \uD5A5\uD558\uAC8C \uB418\uB294\uB370..?"
  - stageName: "\uC2A4\uD14C\uC774\uC9C0 3 - \uC5F0\uAD6C\uC18C \uB3D9\uAD74"
    stageDescription: "\uAE30\uB098\uAE34 \uC815\uAE00\uC744 \uBE60\uC838\uB098\uC628
      \uB05D\uC5D0 \uC2AC\uB77C\uC784 \uC77C\uD589\uC774 \uB3C4\uB2EC\uD55C \uACF3\uC740
      \uB3D9\uAD74 \uD55C\uAC00\uC6B4\uB370. \uC2AC\uB77C\uC784 \uC77C\uD589\uC740
      \uC544\uB974\uB9C8\uB51C\uB85C\uB97C \uB9CC\uB098\uACE0, \uBB34\uC218\uD788
      \uC124\uCE58\uB41C \uD130\uB81B\uB4E4\uC744 \uD53C\uD574 \uB2E4\uC74C \uC9C0\uC5ED\uAE4C\uC9C0
      \uB098\uC544\uAC00\uAC8C \uB418\uB294\uB370..?"
  - stageName: "\uC2A4\uD14C\uC774\uC9C0 4 - \uC5F0\uAD6C\uC18C \uC0AC\uB9C9"
    stageDescription: "\uC5B4\uB450\uC6B4 \uB3D9\uAD74 \uB2E4\uC74C\uC5D0\uB294 \uC0AC\uB9C9,
      \uC5F0\uAD6C\uC18C\uB294 \uC5B4\uB514\uAE4C\uC9C0 \uC774\uC5B4\uC838 \uC788\uB294
      \uAC83\uC77C\uAE4C? \uC758\uBB38\uC744 \uD488\uC740 \uCC44 \uC2AC\uB77C\uC784
      \uC77C\uD589\uC740 \uB098\uC544\uAC00\uAC8C \uB418\uB294\uB370..?"
  anim: {fileID: 2087512113}
  stageNameText: {fileID: 1119592403}
